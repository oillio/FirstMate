{
  "switchModelsOnFlag": false,
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Read(./.env)",
      "Read(./data/**)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./.agents/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./Makefile)",
      "Edit(./tools/guard-files.txt)",
      "Edit(./tools/check_docs.py)",
      "Edit(./tools/check_guard_pr.py)",
      "Edit(./tools/git-hooks/**)",
      "Edit(./tests/**)",
      "Edit(./eval/seeded-defects/**)",
      "Edit(./docs/process/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-model.sh\""
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-model.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/stamp-commit-model.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.sh\""
          }
        ]
      }
    ]
  }
}
